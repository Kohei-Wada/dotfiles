#!/usr/bin/env bash
# Fetch a URL and print its readable text, for an LLM agent to answer from.
# Companion to `websearch`: that finds the URL, this reads the page body.
#
# pi has no MCP by design, so the web-search path is plain CLI tools the agent
# calls through bash. Same reason `websearch` exists for `codex -p ollama`.
set -euo pipefail
url="${1:-}"
[ -n "$url" ] || { echo "usage: webread <url> [max-chars]" >&2; exit 2; }
max="${2:-20000}"
curl -fsSL --max-time 30 -A 'Mozilla/5.0 (X11; Linux x86_64)' "$url" \
  | w3m -dump -T text/html -cols 100 \
  | sed 's/[[:space:]]\+$//' \
  | cat -s \
  | head -c "$max"
