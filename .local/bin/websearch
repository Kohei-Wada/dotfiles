#!/usr/bin/env bash
# Live web search via the private SearXNG on thor. Prints the top results
# as plain text (Title / URL / snippet) for an LLM agent to read.
#
# codex's MCP web_search and the OpenAI-hosted web_search tool do not work with
# local ollama models (codex wraps MCP tools in a `type:"namespace"` schema that
# ollama's /v1/responses cannot execute), so this flat shell command is the
# web-search path for `codex -p ollama`.
set -euo pipefail
: "${SEARXNG_URL:=http://192.168.0.19:8888}"
q="$*"
[ -n "$q" ] || { echo "usage: websearch <query>" >&2; exit 2; }
curl -fsS -G "$SEARXNG_URL/search" \
  --data-urlencode "q=$q" \
  --data-urlencode "format=json" \
  | jq -r '.results[:8][] | "■ \(.title)\n  \(.url)\n  \((.content // "") | gsub("\\s+";" "))"'
