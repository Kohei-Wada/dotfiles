{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "share": "disabled",
    "enabled_providers": [
        "ollama",
        "vllm"
    ],
    "skills": {
        "paths": [
            "~/ghq/github.com/kohei-homelab/homelab-skills/skills"
        ]
    },
    "provider": {
        "vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "vLLM (thor)",
            "options": {
                "baseURL": "http://thor:8000/v1"
            },
            "models": {
                "qwen3.8": {
                    "name": "Qwen3.8 27B (vLLM)",
                    "attachment": true,
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                }
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (thor)",
            "options": {
                "baseURL": "http://thor:11434/v1"
            },
            "models": {
                "huihui_ai/Qwen3.6-abliterated:27b": {
                    "name": "Qwen3.6 27B Abliterated 256K (uncensored)",
                    "limit": {
                        "context": 262144,
                        "output": 8192
                    },
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "qwen3.8:27b": {
                    "name": "Qwen3.8 27B",
                    "attachment": true,
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "qwen3.6:27b": {
                    "name": "Qwen3.6 27B",
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    },
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "ornith:35b": {
                    "name": "Ornith 1.0 35B-A3B MoE (coding)",
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "nemotron-3-nano:30b": {
                    "name": "Nemotron 3 Nano 30B-A3B MoE (Mamba2 hybrid)",
                    "limit": {
                        "context": 524288,
                        "output": 32768
                    }
                },
                "gemma4:31b-it-qat": {
                    "name": "Gemma4 31B IT QAT",
                    "attachment": true,
                    "limit": {
                        "context": 245760,
                        "output": 8192
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "qwen3:8b": {
                    "name": "Qwen3 8B",
                    "limit": {
                        "context": 40960,
                        "output": 8192
                    }
                }
            }
        }
    },
    "mcp": {
        "searxng": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "mcp-searxng"
            ],
            "environment": {
                "SEARXNG_URL": "http://thor:8888"
            },
            "enabled": true
        },
        "ha": {
            "type": "remote",
            "url": "http://homeassistant:8123/api/mcp",
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:HA_TOKEN}"
            },
            "enabled": true
        }
    },
    "model": "ollama/qwen3.8:27b",
    "small_model": "ollama/qwen3.8:27b",
    "compaction": {
        "auto": true
    },
    "permission": {
        "ha_*": "allow",
        "searxng_*": "allow"
    },
    "lsp": true,
    "formatter": true
}
