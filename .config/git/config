[init]
    defaultBranch = main
[include]
    path = ~/.gitconfig.local
[core]
    editor = nvim
    quotepath = false
    excludesFile = ~/.config/git/ignore_global
[fetch]
    # auto prune remote tracking branches
    prune = true
[pull]
    rebase = true
[rebase]
    autoStash = true
[alias]
    whoami = "!git config user.name && git config user.email"
